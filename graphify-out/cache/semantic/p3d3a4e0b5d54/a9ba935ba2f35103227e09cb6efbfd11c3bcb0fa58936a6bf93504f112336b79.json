{"nodes": [{"id": "public_images_vigil_home", "label": "Vigil Today (Home) Screen", "file_type": "image", "source_file": "public/images/vigil/home.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mobile dashboard built from stacked dark rounded cards: a Mayu speech bubble at top, a focus ring with streak, a Start focus CTA, an exam countdown with the prep phase, and a preview of today's plan. Amber is the accent color and there is a bottom tab bar."}, {"id": "public_images_vigil_home_mayu_speech_bubble", "label": "Mayu Coaching Speech Bubble", "file_type": "concept", "source_file": "public/images/vigil/home.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sleepy Mayu says 'Finish the error log, then sleep. Sleep is part of the plan.' The coaching changes with the time of day and treats rest as part of the plan."}, {"id": "public_images_vigil_home_daily_focus_ring", "label": "Daily Focus Ring (0m of 6h 00m)", "file_type": "concept", "source_file": "public/images/vigil/home.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Circular progress ring that tracks today's focused minutes against a daily target."}, {"id": "public_images_vigil_home_streak_consistency", "label": "Streak (11) & 28-Day Consistency (93%)", "file_type": "concept", "source_file": "public/images/vigil/home.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fire-emoji streak paired with a rolling consistency percentage. The percentage softens the all-or-nothing feel of a streak."}, {"id": "public_images_vigil_home_start_focus", "label": "Start Focus Button", "file_type": "concept", "source_file": "public/images/vigil/home.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Main amber CTA on the home screen. Starting a session is one tap away."}, {"id": "public_images_vigil_home_cant_study_today", "label": "\"Can't study today?\" Option", "file_type": "concept", "source_file": "public/images/vigil/home.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Low-emphasis secondary action next to Start focus. Probably lets the student declare a legitimate off day (illness, travel). Its exact behaviour is not shown and is AMBIGUOUS."}, {"id": "public_images_vigil_home_exam_countdown", "label": "IPMAT Indore Exam Countdown (169 days)", "file_type": "concept", "source_file": "public/images/vigil/home.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Countdown card with the exam date (Mon, 3 May), percentage of syllabus done, a progress bar and a large days-remaining number, so the deadline stays in view."}, {"id": "public_images_vigil_home_prep_phase", "label": "Prep Phase 1: Fill the Holes", "file_type": "concept", "source_file": "public/images/vigil/home.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phase-based roadmap: 'Finish every chapter once. Weekly full mock from week one - it is data, not a verdict.' The status reads 'On track'. Mock tests are framed as data so they cause less anxiety."}, {"id": "public_images_vigil_home_bottom_tab_bar", "label": "Mobile Bottom Tab Bar (Today/Focus/Plan/Practice/More)", "file_type": "concept", "source_file": "public/images/vigil/home.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five-tab navigation with the active tab in amber. Lower-frequency sections (Stats and others) sit under More."}], "edges": [{"source": "public_images_vigil_home", "target": "public_images_vigil_