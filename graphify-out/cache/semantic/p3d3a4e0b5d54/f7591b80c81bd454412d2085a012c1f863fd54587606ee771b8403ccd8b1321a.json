{"nodes": [{"id": "public_images_vigil_desk_focus", "label": "Vigil Desktop - Focus Setup (Camera Presence Mode)", "file_type": "image", "source_file": "public/images/vigil/desk-focus.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-column dark UI: left card configures the session (timer mode tabs, task dropdown, presence check, strict mode, big amber 'Start pomodoro' CTA); right card is an allowlist app picker where only checked apps (Acrobat Reader, VS Code) stay open and the rest are blocked, with study/social/distraction tags. Headline: 'Pick what you need. Everything else is blocked until you stop.'"}, {"id": "public_images_vigil_desk_focus_app_picker", "label": "Allowlist App Picker (Only apps I pick)", "file_type": "concept", "source_file": "public/images/vigil/desk-focus.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inverts blocking: student whitelists needed apps; everything else is blocked. Apps carry study/never/social/distraction tags."}, {"id": "public_images_vigil_desk_focus_presence_check", "label": "Presence Check (Camera / Check-ins / Off)", "file_type": "concept", "source_file": "public/images/vigil/desk-focus.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Camera mode glances every 20s (away pauses timer, 10 min away ends session); Check-ins mode asks for random taps every 12-20 min."}, {"id": "public_images_vigil_desk_focus_strict_mode", "label": "Strict Mode", "file_type": "concept", "source_file": "public/images/vigil/desk-focus.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stopping early needs a reason and a short wait and goes on the record; adds friction to quitting."}, {"id": "public_images_vigil_desk_focus_timer_modes", "label": "Timer Modes (Stopwatch / Timer / Pomodoro 25/5)", "file_type": "concept", "source_file": "public/images/vigil/desk-focus.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_images_vigil_desk_focus_cross_device_lock", "label": "Cross-Device Lock and Website Allowlist", "file_type": "concept", "source_file": "public/images/vigil/desk-focus.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Toggles to lock other devices too and to only allow specific websites (otherwise distracting sites plus shorts/reels are blocked)."}], "edges": [{"source": "public_images_vigil_desk_focus", "target": "public_images_vigil_desk_focus_app_picker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/images/vigil/desk-focus.webp", "source_location": null, "weight": 1.0}, {"source": "public_images_vigil_desk_focus", "target": "public_images_vigil_desk_focus_presence_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/images/vigil/desk-focus.webp", "source_location": null, "weight": 1.0}, {"source": "public_images_vigil_desk_focus", "target": "public_images_vigil_desk_focus_strict_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/images/vigil/desk-focus.webp", "source_location": null, "weight": 1.0}, {"source": "public_images_vigil_desk_focus", "target": "public_images_vigil_desk_focus_timer_modes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/images/vigil/desk-focus.webp", "source_location": null, "weight": 1.0}, {"source": "public_images_vigil_desk_focus", "target": "public_images_vigil_desk_focus_cross_device_lock", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/images/vigil/de