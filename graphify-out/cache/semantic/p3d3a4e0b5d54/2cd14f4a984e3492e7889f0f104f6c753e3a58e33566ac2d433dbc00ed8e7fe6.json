{"nodes": [{"id": "public_images_vigil_session", "label": "Vigil Focus Session Screen", "file_type": "image", "source_file": "public/images/vigil/session.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live focus session. A green 'Focusing' status pill, a large circular timer ring with an amber progress knob, the current task title, a fierce Mayu with a taunt, a rationed pee-break button, a padlocked red-outlined Stop, and a 2x2 grid of distraction counters."}, {"id": "public_images_vigil_session_focus_timer", "label": "Focus Timer Ring (round 1 - strict)", "file_type": "concept", "source_file": "public/images/vigil/session.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Big monospace timer inside a progress ring. It shows the round number and mode, and the task it is linked to ('Starter: 10 easy questions you already know')."}, {"id": "public_images_vigil_session_strict_mode", "label": "Strict Mode", "file_type": "concept", "source_file": "public/images/vigil/session.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Session mode label 'strict'. Probably means stopping early is locked and breaks are rationed."}, {"id": "public_images_vigil_session_pee_break", "label": "Pee Break (2 min, 3 left)", "file_type": "concept", "source_file": "public/images/vigil/session.webp", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Short breaks with a fixed length and a limited count. Allows real needs without letting the session leak away; a humorous, human touch."}, {"id": "public_images_vigil_session_locked_stop", "label": "Locked Stop Button", "file_type": "concept", "source_file": "public/images/vigil/session.webp", "source_location": null, "source_url": null, "captured_at": null, "auth